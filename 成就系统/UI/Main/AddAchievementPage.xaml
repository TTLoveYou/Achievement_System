<Page x:Class="成就系统.UI.Main.AddAchievementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:成就系统.UI.Main"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      
      
      mc:Ignorable="d"
      Title="AddAchievementPage"
      d:DesignHeight="777" d:DesignWidth="999"
      Background="Transparent">



    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        
        <!--标题区域-->
        <TextBlock x:Name="AchievementOperation" Grid.Row="0" Text="添加成就" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Margin="20, 0, 0, 0" Foreground="#333333"/>

        <!--是否编辑选择框-->
        <CheckBox x:Name="EditModeCheckBox" 
          Grid.Row="0" 
          Content="编辑" 
          HorizontalAlignment="Right" 
          VerticalAlignment="Center" 
          Margin="0,0,20,0" 
          Visibility="Collapsed"
          Checked="EditModeCheckBox_Checked"
          Unchecked="EditModeCheckBox_Unchecked"/>

        <!--内容区域-->
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--左侧：分类/日期/完成度/评分-->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="25" Cursor="">

                    <!--分类-->
                    <ikw:SimpleStackPanel Orientation="Vertical" Spacing="8">
                        <TextBlock Text="成就分类*：" FontSize="18" FontWeight="Bold" Foreground="#444444"/>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="15">
                            <ComboBox x:Name="CategoryComboBox" ui:ControlHelper.PlaceholderText="选择大类" Width="140" FontSize="15"
                                  Style="{StaticResource CategoryComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource CategoryComboBoxItemStyle}"
                                  SelectionChanged="CategoryComboBox_SelectionChanged"/>
                            <ComboBox x:Name="SubcategoryComboBox" ui:ControlHelper.PlaceholderText="选择小类" Width="140" FontSize="15"
                                  Style="{StaticResource CategoryComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource CategoryComboBoxItemStyle}"/>
                        </ikw:SimpleStackPanel>
                    </ikw:SimpleStackPanel>

                    <!--日期-->
                    <ikw:SimpleStackPanel Orientation="Vertical" Spacing="8">
                        <TextBlock Text="成就日期*：" FontSize="18" FontWeight="Bold" Foreground="#444444"/>
                        <DatePicker x:Name="AchievementDatePicker" FontSize="16" Width="200" Style="{StaticResource ModernDatePickerStyle}" HorizontalAlignment="Left"
                                    SelectedDateChanged="AchievementDatePicker_SelectedDateChanged" Cursor="Hand"
                                    />
                    </ikw:SimpleStackPanel>

                    <!--完成度-->
                    <ikw:SimpleStackPanel Orientation="Vertical" Spacing="8">
                        <TextBlock Text="完成度：" FontSize="18" FontWeight="Bold" Foreground="#444444"/>
                        <Grid>
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                <!-- 四个格子表示完成度 -->
                                <Border x:Name="ProgressBlock1" 
                                    Style="{StaticResource ProgressBlockStyle}"
                                    MouseLeftButtonDown="ProgressBlock_MouseLeftButtonDown"
                                    Tag="25"/>
                                <Border x:Name="ProgressBlock2" 
                                    Style="{StaticResource ProgressBlockStyle}"
                                    MouseLeftButtonDown="ProgressBlock_MouseLeftButtonDown"
                                    Tag="50"/>
                                <Border x:Name="ProgressBlock3" 
                                    Style="{StaticResource ProgressBlockStyle}"
                                    MouseLeftButtonDown="ProgressBlock_MouseLeftButtonDown"
                                    Tag="75"/>
                                <Border x:Name="ProgressBlock4" 
                                    Style="{StaticResource ProgressBlockStyle}"
                                    MouseLeftButtonDown="ProgressBlock_MouseLeftButtonDown"
                                    Tag="100"/>
                            </ikw:SimpleStackPanel>
                            <TextBlock Text="0%" 
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="160,0,0,0" 
                                   VerticalAlignment="Center"
                                   Foreground="#4CAF50"
                                   x:Name="ProgressText"/>
                        </Grid>
                    </ikw:SimpleStackPanel>

                    <!--评分-->
                    <ikw:SimpleStackPanel Orientation="Vertical" Spacing="8">
                        <TextBlock Text="评分*(0.0-9.9)：" FontSize="18" FontWeight="Bold" Foreground="#444444"/>
                        <Grid>
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="5">
                                <Button x:Name="DecreaseScoreButton" Content="-" Style="{StaticResource ScoreButtonStyle}"
                                        Click="DecreaseScoreButton_Click"/>
                                <TextBox x:Name="ScoreTextBox" Width="80" Height="35" TextAlignment="Center" Text="0.0" Style="{StaticResource FormTextBox}"
                                     PreviewTextInput="ScoreTextBox_PreviewTextInput"
                                     PreviewKeyDown="DatePickerorScoreBox_PreviewKeyDown"
                                     GotFocus="ScoreTextBox_GotFocus"
                                     LostFocus="ScoreTextBox_LostFocus"/>
                                <Button x:Name="IncreaseScoreButton" Content="+" Style="{StaticResource ScoreButtonStyle}"
                                        Click="IncreaseScoreButton_Click"/>
                            </ikw:SimpleStackPanel>
                        </Grid>

                    </ikw:SimpleStackPanel>

                    <!--生日控件-->
                    <ikw:SimpleStackPanel HorizontalAlignment="Center" Margin="0,40,0,0">
                        <!--生日信息-->
                        <TextBlock x:Name="BirthdayLine"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="#87CEEB"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    Visibility="Collapsed"/>

                        <!--周年信息-->
                        <TextBlock x:Name="AnniversaryLine"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FFD700" 
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Visibility="Collapsed"/>

                    </ikw:SimpleStackPanel>
                    
                    
                </ikw:SimpleStackPanel>

            </Border>

            <!-- 右侧：图片/名称/描述 -->
            <Border Grid.Column="1" 
                    Margin="20,0,0,0"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="20">

                    <!-- 图片预览区域 -->
                    <ikw:SimpleStackPanel Orientation="Vertical" Spacing="10">
                        <TextBlock Text="成就图片：" FontSize="18" FontWeight="Bold" Foreground="#444444"/>
                        <Grid>
                            <Border Width="160" 
                                    Height="160" 
                                    Background="#F0F0F0"
                                    BorderBrush="#CCCCCC" 
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <!-- 图片选择按钮 -->
                                    <Button x:Name="SelectImageButton" 
                                            Click="SelectImageButton_Click"
                                            Background="Transparent" 
                                            BorderBrush="Transparent"
                                            HorizontalAlignment="Stretch" 
                                            VerticalAlignment="Stretch"
                                            Cursor="Hand">
                                        <Grid>
                                            <!-- 加号图标 -->
                                            <Path x:Name="PlusIcon" Data="M 50,0 L 50,100 M 0,50 L 100,50" Stroke="#AAAAAA" 
                                                  StrokeThickness="2"
                                                  Width="100" 
                                                  Height="100"
                                                  Visibility="Visible"/>
                                            <!-- 图片预览 -->
                                            <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>

                                    <!-- 删除图片按钮 -->
                                    <Button x:Name="DeleteImageButton" 
                                            Content="删除图片"
                                            Click="DeleteImageButton_Click"
                                            Width="80" 
                                            Height="30"
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,10"
                                            Background="#FF4444" 
                                            Foreground="White"
                                            BorderBrush="Transparent"
                                            Visibility="Collapsed"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="推荐尺寸：300×300像素" FontSize="12" Margin="170,0,0,0" VerticalAlignment="Bottom" Foreground="#666666"/>
                        </Grid>
                    </ikw:SimpleStackPanel>

                    <!-- 名称 -->
                    <ikw:SimpleStackPanel Orientation="Vertical" Spacing="8">
                        <TextBlock Text="成就名称*：" FontSize="18" FontWeight="Bold" Foreground="#444444"/>
                        <TextBox x:Name="AchievementNameTextBox" Height="40" FontSize="16" Style="{StaticResource FormTextBox}"/>
                    </ikw:SimpleStackPanel>

                    <!-- 描述 -->
                    <ikw:SimpleStackPanel Orientation="Vertical" Spacing="8">
                        <TextBlock Text="成就描述*：" FontSize="18" FontWeight="Bold" Foreground="#444444"/>
                        <TextBox x:Name="DescriptionTextBox" 
                                 TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" 
                                 Height="Auto" MinHeight="120" MaxHeight="250"
                                 FontSize="16"
                                 Style="{StaticResource FormTextBox}"
                                 AcceptsReturn="True"/>
                    </ikw:SimpleStackPanel>

                </ikw:SimpleStackPanel>


            </Border>
            
        </Grid>


        <!-- 底部按钮 -->
        <Grid Grid.Row="2" Background="White">
            <ikw:SimpleStackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Spacing="20">
                <Button Content="返回" Width="120" Height="40" FontSize="16" Click="CancelButton_Click"
                        Background="#F0F0F0"
                        Foreground="#333333"
                        Cursor="Hand"/>
                <Button Content="保存" x:Name="SaveButton"  Width="160" Height="45" FontSize="16" FontWeight="Bold" Background="#4CAF50" Foreground="White" Cursor="Hand"
                        Click="SaveButton_Click"/>
            </ikw:SimpleStackPanel>
        </Grid>



    </Grid>
</Page>
