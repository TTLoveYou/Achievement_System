<Page x:Class="成就系统.UI.Main.ConsolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:成就系统.UI.Main"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      
      mc:Ignorable="d" 
      Title="ConsolePage"
      d:DesignHeight="777" d:DesignWidth="999"
      Background="SkyBlue">


    <Page.Resources>
        <!-- 颜色定义 -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4361ee"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#38bdf8"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10b981"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#ef4444"/>
        <SolidColorBrush x:Key="LightBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DarkText" Color="#2B2D42"/>
        <SolidColorBrush x:Key="MediumText" Color="#64748b"/>

        <!-- 树形视图样式 -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{StaticResource LightBackground}"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>

        <!-- 子类别项模板 (小类) -->
        <DataTemplate x:Key="SubcategoryTemplate">
            <ikw:SimpleStackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SmallCategory}" Margin="5,0,0,0"/>
                <TextBlock Text="(" Foreground="#64748b"/>
                <TextBlock Text="{Binding AchievementCount}" Foreground="#64748b"/>
                <TextBlock Text=")" Foreground="#64748b"/>
            </ikw:SimpleStackPanel>
        </DataTemplate>

        <!-- 类别项模板 (大类) -->
        <HierarchicalDataTemplate x:Key="CategoryTemplate" 
                              ItemsSource="{Binding Subcategories}"
                              ItemTemplate="{StaticResource SubcategoryTemplate}">
            <ikw:SimpleStackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding BigCategory}" FontWeight="SemiBold"/>
                <TextBlock Text="(" Foreground="#64748b"/>
                <TextBlock Text="{Binding AchievementCount}" Foreground="#64748b"/>
                <TextBlock Text=")" Foreground="#64748b"/>
            </ikw:SimpleStackPanel>
        </HierarchicalDataTemplate>

       


        <!-- 按钮样式 -->
        <Style TargetType="Button" x:Key="MyButton">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!--导入按钮样式-->
        <Style TargetType="Button" x:Key="ImportButton">
            <Setter Property="Background" Value="#10b981"/>
            <Setter Property="Content" Value="导入成就"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!--导出按钮样式-->
        <Style TargetType="Button" x:Key="ExportButton">
            <Setter Property="Background" Value="#38bdf8"/>
            <Setter Property="Content" Value="导出成就"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!--添加按钮样式-->
        <Style TargetType="Button" x:Key="AddButton">
            <Setter Property="Background" Value="#10b981"/>
            <Setter Property="Content" Value="添加"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!--删除按钮样式-->
        <Style TargetType="Button" x:Key="DeleteButton">
            <Setter Property="Background" Value="#ef4444"/>
            <Setter Property="Content" Value="删除"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 文本样式 -->
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
        </Style>

        <!-- 操作面板样式 -->
        <Style TargetType="Border" x:Key="OperationPanelStyle">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <ikw:SimpleStackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="控制台" Style="{DynamicResource SectionTitleStyle}"/>
            <TextBlock Text="(成就类别管理及导入/导出数据)" FontSize="16" Foreground="#64748b" VerticalAlignment="Bottom" Margin="0, 0, 0, 15"/>
        </ikw:SimpleStackPanel>

        <!-- 导入/导出操作 -->
        <ikw:SimpleStackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,10">
            <Button Style="{DynamicResource ImportButton}" Click="ImportButton_Click"/>
            <Button x:Name="ExportButton" Style="{DynamicResource ExportButton}" Click="ExportButton_Click"/>
        </ikw:SimpleStackPanel>

        <!-- 树形视图区域 -->
        <Border Grid.Row="2" Style="{DynamicResource OperationPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!--副标题-->
                <TextBlock Grid.Row="0" Text="成就分类" Foreground="Black" Style="{DynamicResource SectionTitleStyle}" FontSize="18" Margin="0,0,0,10"/>

                <!--内容-->                
                <TreeView x:Name="AchievementTree" Grid.Row="1"
                          ItemTemplate="{StaticResource CategoryTemplate}"
                          SelectedItemChanged="AchievementTree_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <!-- 右键菜单 -->
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="修改类别名称" Click="EditCategoryName_Click"/>
                            <MenuItem Header="移动类别数据">
                                <MenuItem Header="移动到大类别" Click="MoveToBigCategory_Click"/>
                                <MenuItem Header="移动到小类别" Click="MoveToSmallCategory_Click"/>
                            </MenuItem>
                            <MenuItem Header="删除类别数据" Click="DeleteCategoryData_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>

                <!--底部按钮-->
                <ikw:SimpleStackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Style="{StaticResource AddButton}" Click="AddCategory_Click" Content="添加类别"/>
                    <Button x:Name="DeleteButton" Style="{StaticResource DeleteButton}" Click="DeleteCategory_Click" Margin="10,0,0,0"/>
                </ikw:SimpleStackPanel>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="#64748b"/>
            </StatusBarItem>
            <StatusBarItem>
                <ikw:SimpleStackPanel Orientation="Horizontal" Margin="10, 0" HorizontalAlignment="Right">

                    <TextBlock x:Name="TotalAchievementsText" Text="成就总数：加载中..." Foreground="#64748b"/>
                    
                    <!-- 加载动画 -->
                    <ui:ProgressRing x:Name="LoadingRing"
                                      Width="16" Height="16"
                                      Margin="10,0,0,0"
                                      Foreground="#4361ee"
                                      Visibility="Collapsed"
                                      IsActive="True"/>
                </ikw:SimpleStackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- 添加类别对话框 -->
        <Border x:Name="AddCategoryDialog" 
                Grid.RowSpan="4"
                Visibility="Collapsed"
                Background="#80000000"
                Panel.ZIndex="1">
            <Border Background="SkyBlue" 
                    Width="300" Height="250"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="添加成就分类" Style="{StaticResource SectionTitleStyle}" FontSize="18" HorizontalAlignment="Center"/>

                    <!--大类-->
                    <ikw:SimpleStackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="大类名称:" Margin="0,0,0,10" FontSize="18" FontWeight="Bold" Foreground="#444444"/>
                        <ComboBox x:Name="NewCategoryName" IsEditable="True" Width="120" Background="#64748b"/>
                    </ikw:SimpleStackPanel>
                    <!--小类-->
                    <ikw:SimpleStackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="小类名称:" Margin="0,0,0,10" FontSize="18" FontWeight="Bold" Foreground="#444444"/>
                        <TextBox x:Name="NewSubcategoryName" Width="120" Background="#64748b"/>
                    </ikw:SimpleStackPanel>


                    <ikw:SimpleStackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" 
                                Click="CancelAddCategory_Click"
                                Background="Transparent" 
                                Foreground="#64748b"/>
                        <Button Content="添加" 
                                Click="ConfirmAddCategory_Click"
                                Background="#10b981"
                                Foreground="White"
                                Width="80"/>
                    </ikw:SimpleStackPanel>
                </Grid>
            </Border>
        </Border>
        
        <!-- 导入对话框 -->
        <Border x:Name="ImportDialog" 
                Grid.RowSpan="4"
                Visibility="Collapsed"
                Background="#80000000"
                Panel.ZIndex="1">
            <Border Background="White" 
                    Width="400" Height="300"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <!-- 添加状态文本行 -->
                    </Grid.RowDefinitions>

                    <!--副标题-->
                    <TextBlock Grid.Row="0" Text="导入成就数据" Style="{StaticResource SectionTitleStyle}" FontSize="18"/>

                    <!--内容区-->
                    <ikw:SimpleStackPanel Grid.Row="1" VerticalAlignment="Center" >
                        <Button x:Name="SelectFileButton" Content="选择 Excel 文件..." HorizontalAlignment="Center"
                                Width="200" Style="{DynamicResource MyButton}"
                                Click="SelectFile_Click"/>
                        <TextBlock x:Name="SelectedFileText" 
                                   Margin="0,15,0,0"
                                   Text="未选择文件"
                                   HorizontalAlignment="Center"
                                   Foreground="#64748b"/>
                    </ikw:SimpleStackPanel>

                    <!--操作区-->
                    <ikw:SimpleStackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelImportButton" Content="取消" Style="{DynamicResource MyButton}"
                                Click="CancelImport_Click"
                                Background="Transparent" 
                                Foreground="#64748b"/>
                        <Button x:Name="ImportButton" 
                                Content="导入" 
                                Click="ConfirmImport_Click"
                                Background="#10b981"
                                Foreground="White"
                                Width="80"/>
                    </ikw:SimpleStackPanel>

                    <!-- 进度条 -->
                    <ui:ProgressBar x:Name="ImportProgressBar" 
                                 Grid.Row="3" Value="20"
                                 Margin="0,20,0,0"
                                 Height="10"
                                 Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Border>
    </Grid>


</Page>
