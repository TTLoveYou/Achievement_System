<Page x:Class="成就系统.UI.Main.GalaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:成就系统.UI.Main"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:converters="clr-namespace:成就系统.Utilities"
      SizeChanged="Page_SizeChanged"
      Unloaded="Page_Unloaded"
      
      
      mc:Ignorable="d" 
      d:DesignHeight="777" d:DesignWidth="999"
      Title="GalaPage"
      Background="Transparent">

    <Grid>
        <!-- 加载指示器 -->
        <Grid x:Name="LoadingIndicator" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <ui:ProgressBar  Width="200" Height="6" IsIndeterminate="True" Foreground="#FF6A5ACD"/>
            <TextBlock Text="加载庆典成就中..." Margin="0,15,0,0" HorizontalAlignment="Center" Foreground="#555"/>
        </Grid>

        <!-- 错误提示 -->
        <Border x:Name="ErrorContainer" 
                Visibility="Collapsed"
                Background="#FFF8E1E1" 
                CornerRadius="8"
                Padding="20"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="14" Foreground="#D32F2F" Margin="0,0,0,10"/>
                <Button Content="重试" Padding="10,5" Background="#FF6A5ACD" Foreground="White" Click="RefreshButton_Click" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 主内容区域 -->
        <ui:ScrollViewerEx>
            <ikw:SimpleStackPanel Margin="20">
                <!-- 页面标题 -->
                <ikw:SimpleStackPanel Margin="0,0,0,30">
                    <TextBlock Text="成就庆典" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextForeground}"/>
                    <TextBlock Text="庆祝特殊成就的日子" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>

                    <!-- 刷新按钮 -->
                    <Button Content="刷新数据" Padding="10,5" 
                            Background="Transparent" Foreground="{DynamicResource PrimaryColor}" FontSize="14"
                            BorderBrush="{DynamicResource PrimaryColor}" BorderThickness="1"
                            HorizontalAlignment="Right" Margin="0,10,0,0"
                            Click="RefreshButton_Click"/>

                </ikw:SimpleStackPanel>

                <!-- 生日成就区域 -->
                <ikw:SimpleStackPanel Margin="0,0,0,40">
                    <!-- 区域标题 -->
                    <ikw:SimpleStackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🎂🎂" FontSize="24" Margin="0,0,10,0"/>
                        <TextBlock Text="生日祝贺" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextForeground}"/>
                        <TextBlock Text="（今天是特殊的一天）" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Bottom"/>

                    </ikw:SimpleStackPanel>

                    <!-- 无生日成就提示 -->
                    <TextBlock x:Name="NoBirthdayText" Text="当前无过生日的成就" 
                               FontSize="14" Foreground="{DynamicResource TextSecondary}" 
                               HorizontalAlignment="Center" Margin="0,50,0,50" 
                               Visibility="Collapsed"/>

                    <!-- 生日成就卡片容器（横向滚动） -->
                    <Border x:Name="BirthdayContainer" 
                            ClipToBounds="True"
                            MouseEnter="ScrollViewer_MouseEnter"
                            MouseLeave="ScrollViewer_MouseLeave">
                        <ui:ScrollViewerEx
                                  HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Disabled" Background="#8087CEEB">
                            <ItemsControl ItemsSource="{Binding BirthdayAchievements}" x:Name="BirthdayItemsControl" RenderTransformOrigin="0.5,0.5">
                                <ItemsControl.RenderTransform>
                                    <TranslateTransform x:Name="BirthdayTransform"/>
                                </ItemsControl.RenderTransform>

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 成就卡片 -->
                                        <Border Width="196" Height="260" Margin="24" 
                                            CornerRadius="20" Background="White"
                                            BorderBrush="#E0E0E0" BorderThickness="1"
                                            Effect="{StaticResource CardShadowEffect}"
                                            MouseLeftButtonDown="AchievementCard_Click"
                                            Cursor="Hand">

                                            <!-- 卡片内容（与主页一致） -->
                                            <Grid Grid.Row="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 生日标识 -->
                                                    <RowDefinition Height="170"/>
                                                    <!-- 图片区域 -->
                                                    <RowDefinition Height="30"/>
                                                    <!-- 名称区域 -->
                                                    <RowDefinition Height="*"/>
                                                    <!-- 状态区域 -->
                                                </Grid.RowDefinitions>

                                                <!-- 生日标识 -->
                                                <Border Grid.Row="0" Background="#FFF48FB1" CornerRadius="20,20,0,0" 
                                                                Height="30" VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="🎂" FontSize="16"/>
                                                        <TextBlock Text="生日快乐" Foreground="White" FontWeight="Bold" Margin="5,0"/>
                                                        <TextBlock Text="🎂" FontSize="16"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 图片区域 -->
                                                <Border Grid.Row="1" Background="#F5F5F5" Margin="20,0,20,0" CornerRadius="5">
                                                    <Image Stretch="UniformToFill" VerticalAlignment="Center">
                                                        <Image.Source>
                                                            <Binding Path="ImagePath">
                                                                <Binding.Converter>
                                                                    <converters:ImagePathConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Image.Source>

                                                        <!-- 鼠标悬停提示 可以使用 ToolTipService.ToolTip-->
                                                        <Image.ToolTip>
                                                            <ToolTip Placement="Mouse" 
                                                                  HorizontalOffset="10"
                                                                  VerticalOffset="10"
                                                                  Style="{StaticResource CustomToolTipStyle}">
                                                                <ikw:SimpleStackPanel>
                                                                    <TextBlock Text="{Binding AchievementName}" 
                                                                                   FontWeight="Bold" 
                                                                                   FontSize="14"
                                                                                   Margin="0,0,0,5"/>
                                                                    <TextBlock Text="{Binding Description}" 
                                                                                    FontSize="12"
                                                                                    TextWrapping="Wrap"
                                                                                    MaxWidth="300"/>
                                                                </ikw:SimpleStackPanel>
                                                            </ToolTip>
                                                        </Image.ToolTip>

                                                    </Image>
                                                </Border>

                                                <!-- 名称区域 -->
                                                <TextBlock Grid.Row="2" Text="{Binding AchievementName}" 
                                                       FontSize="16" FontWeight="SemiBold" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="180" Foreground="Black"/>

                                                <!-- 底部状态栏 -->
                                                <Border Grid.Row="3" Background="#F0F0F0" 
                                                        CornerRadius="0,0,20,20" 
                                                        Padding="10,0" Margin="0,0,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- 评分等级  -->
                                                        <Grid Grid.Column="0" Margin="20,0,0,0">
                                                            <!-- 描边层 -->
                                                            <TextBlock 
                                                            Style="{StaticResource StrokedTextStyle}"
                                                            Text="{Binding Score, Converter={StaticResource ScoreToGradeConverter}}"
                                                            Foreground="Black"/>
                                                            <!-- 描边颜色 -->

                                                            <!-- 前景层 -->
                                                            <TextBlock 
                                                            Style="{StaticResource StrokedTextStyle}"
                                                            Text="{Binding Score, Converter={StaticResource ScoreToGradeConverter}}"
                                                            Foreground="{Binding Score, Converter={StaticResource ScoreToGradeColorConverter}}"/>

                                                        </Grid>


                                                        <!--完成程度-->
                                                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0"
                                                                   Text="{Binding CompletionDegree, Converter={StaticResource DegreeConverterStyle}}"
                                                                   Foreground="{Binding CompletionDegree, Converter={StaticResource DegreeConverterColor}}"
                                                                   Style="{StaticResource StrokedTextStyle}"
                                                                   FontSize="16" HorizontalAlignment="Right"
                                                                   FontWeight="SemiBold"/>

                                                            <ProgressBar Grid.Row="1"
                                                                    Value="{Binding CompletionDegree, Converter={StaticResource DegreeConverterStyle}, ConverterParameter=Value}"
                                                                    Foreground="{Binding CompletionDegree, Converter={StaticResource DegreeConverterColor}}"
                                                                    Background="Black"
                                                                    Maximum="100"/>

                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:ScrollViewerEx>
                    </Border>
                </ikw:SimpleStackPanel>

                <!--周年成就区域-->
                <ikw:SimpleStackPanel>
                    <!-- 区域标题 -->
                    <ikw:SimpleStackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🏆🏆" FontSize="24" Margin="0,0,10,0"/>
                        <TextBlock Text="周年纪念" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextForeground}"/>
                        <TextBlock Text="（五周年成倍递增）" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                    </ikw:SimpleStackPanel>

                    <!-- 无整周年成就提示 -->
                    <TextBlock x:Name="NoAnniversaryText" Text="当前无整周年的成就" 
                               FontSize="14" Foreground="{DynamicResource TextSecondary}" 
                               HorizontalAlignment="Center" Margin="0,50,0,50" 
                               Visibility="Collapsed"/>

                    <!-- 整周年成就卡片容器（横向滚动） -->
                    <Border x:Name="AnniversaryContainer" 
                            ClipToBounds="True"
                            MouseEnter="ScrollViewer_MouseEnter"
                            MouseLeave="ScrollViewer_MouseLeave">
                        <ui:ScrollViewerEx
                                       HorizontalScrollBarVisibility="Auto" 
                                       VerticalScrollBarVisibility="Disabled" Background="#8087CEEB">
                            <ItemsControl ItemsSource="{Binding AnniversaryAchievements}" x:Name="AnniversaryItemsControl" RenderTransformOrigin="0.5,0.5">
                                <ItemsControl.RenderTransform>
                                    <TranslateTransform x:Name="AnniversaryTransform"/>
                                </ItemsControl.RenderTransform>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 成就卡片 -->
                                        <Border Width="196" Height="260" Margin="24" 
                                            CornerRadius="20" Background="White"
                                            BorderBrush="#E0E0E0" BorderThickness="1"
                                            Effect="{StaticResource CardShadowEffect}"
                                            MouseLeftButtonDown="AchievementCard_Click"
                                            Cursor="Hand">

                                            <!-- 卡片内容（与主页一致） -->
                                            <Grid Grid.Row="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 周年标识 -->
                                                    <RowDefinition Height="170"/>
                                                    <!-- 图片区域 -->
                                                    <RowDefinition Height="30"/>
                                                    <!-- 名称区域 -->
                                                    <RowDefinition Height="*"/>
                                                    <!-- 状态区域 -->
                                                </Grid.RowDefinitions>

                                                <!-- 周年标识 -->
                                                <Border Grid.Row="0" Background="#FF64B5F6" CornerRadius="20,20,0,0" 
                                                                    Height="30" VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="🏆" FontSize="16"/>
                                                        <TextBlock Text="{Binding AnniversaryYears, StringFormat={}{0}周年}" Foreground="White" FontWeight="Bold" Margin="5,0"/>
                                                        <TextBlock Text="🏆" FontSize="16"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 图片区域 -->
                                                <Border Grid.Row="1" Background="#F5F5F5" Margin="20,0,20,0" CornerRadius="5">
                                                    <Image Stretch="UniformToFill" VerticalAlignment="Center">
                                                        <Image.Source>
                                                            <Binding Path="ImagePath">
                                                                <Binding.Converter>
                                                                    <converters:ImagePathConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Image.Source>

                                                        <!-- 鼠标悬停提示 可以使用 ToolTipService.ToolTip-->
                                                        <Image.ToolTip>
                                                            <ToolTip Placement="Mouse" 
                                                                  HorizontalOffset="10"
                                                                  VerticalOffset="10"
                                                                  Style="{StaticResource CustomToolTipStyle}">
                                                                <ikw:SimpleStackPanel>
                                                                    <TextBlock Text="{Binding AchievementName}" 
                                                                                           FontWeight="Bold" 
                                                                                           FontSize="14"
                                                                                           Margin="0,0,0,5"/>
                                                                    <TextBlock Text="{Binding Description}" 
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           MaxWidth="300"/>
                                                                </ikw:SimpleStackPanel>
                                                            </ToolTip>
                                                        </Image.ToolTip>

                                                    </Image>
                                                </Border>

                                                <!-- 名称区域 -->
                                                <TextBlock Grid.Row="2" Text="{Binding AchievementName}" 
                                                                       FontSize="16" FontWeight="SemiBold" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="180" Foreground="Black" />

                                                <!-- 底部状态栏 -->
                                                <Border Grid.Row="3" Background="#F0F0F0" 
                                                                    CornerRadius="0,0,20,20" 
                                                                    Padding="10,0" Margin="0,0,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- 评分等级  -->
                                                        <Grid Grid.Column="0" Margin="20,0,0,0">
                                                            <!-- 描边层 -->
                                                            <TextBlock 
                                                                        Style="{StaticResource StrokedTextStyle}"
                                                                        Text="{Binding Score, Converter={StaticResource ScoreToGradeConverter}}"
                                                                        Foreground="Black"/>
                                                            <!-- 描边颜色 -->

                                                            <!-- 前景层 -->
                                                            <TextBlock 
                                                                        Style="{StaticResource StrokedTextStyle}"
                                                                        Text="{Binding Score, Converter={StaticResource ScoreToGradeConverter}}"
                                                                        Foreground="{Binding Score, Converter={StaticResource ScoreToGradeColorConverter}}"/>

                                                        </Grid>


                                                        <!--完成程度-->
                                                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0"
                                                                       Text="{Binding CompletionDegree, Converter={StaticResource DegreeConverterStyle}}"
                                                                       Foreground="{Binding CompletionDegree, Converter={StaticResource DegreeConverterColor}}"
                                                                       Style="{StaticResource StrokedTextStyle}"
                                                                       FontSize="16" HorizontalAlignment="Right"
                                                                       FontWeight="SemiBold"/>

                                                            <ProgressBar Grid.Row="1"
                                                                        Value="{Binding CompletionDegree, Converter={StaticResource DegreeConverterStyle}, ConverterParameter=Value}"
                                                                        Foreground="{Binding CompletionDegree, Converter={StaticResource DegreeConverterColor}}"
                                                                        Background="Black"
                                                                        Maximum="100"/>

                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:ScrollViewerEx>
                    </Border>
                </ikw:SimpleStackPanel>

            </ikw:SimpleStackPanel>
        </ui:ScrollViewerEx>
    </Grid>


</Page>
