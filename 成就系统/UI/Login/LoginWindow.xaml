<Window x:Class="成就系统.UI.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:成就系统.UI.Login"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Acrylic11"
        ui:TitleBar.Height="36" 
        
        mc:Ignorable="d"
        Title="成就系统" Height="520" Width="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- 标题区域 -->
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Hyperlink NavigateUri="https://space.bilibili.com/476358448?spm_id_from=333.1007.0.0"
               RequestNavigate="Hyperlink_RequestNavigate"
               TextDecorations="None">
                <TextBlock Text="欢迎登录成就管理系统" 
                  FontSize="36" 
                  FontWeight="Bold"
                  FontFamily="Microsoft YaHei"/>
            </Hyperlink>
        </TextBlock>

        <!-- 登录表单 -->
        <StackPanel Grid.Row="1" 
            Width="300"
            VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="账户" 
                  FontSize="20"
                  FontWeight="Bold"                           
                  VerticalAlignment="Center"
                  Margin="0,0,10,0"/>
                <TextBox x:Name="txtUsername" ui:ControlHelper.PlaceholderText="Account"
                 Grid.Column="1" 
                 Height="35" 
                 VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" 
                  Text="密码" 
                  FontSize="20"
                  FontWeight="Bold"
                  VerticalAlignment="Center"
                  Margin="0,15,10,0"/>
                <PasswordBox x:Name="pwdPassword"
                    Grid.Row="1" 
                    Grid.Column="1" 
                    Height="35"
                    Margin="0,15,0,0"
                    VerticalContentAlignment="Center"/>
            </Grid>

            <!-- 登录和注册按钮 -->
            <Grid Margin="0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" x:Name="btnLogin" 
                Content="登录"
                Width="80" 
                Height="30"
                FontSize="16"
                FontWeight="Bold"
                Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}" Click="Login_Response"/>
                <Button Grid.Column="3" 
                Content="注册" x:Name="btnRegister"
                Width="80" 
                Height="30"
                FontSize="16"
                FontWeight="Bold"
                Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}" Click="Response_Response"/>
            </Grid>
        </StackPanel>

        <!-- 底部按钮区域 -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="btnFaceLogin" Click="FaceLogin_Click" HorizontalAlignment="Left">
                <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.NUIFace}" Content="人脸快捷登录" IconSize="25" Foreground="Cyan" HorizontalContentAlignment="Center" FontWeight="Bold"
                    FontSize="16"
                    Width="128" 
                    Height="28"/>
            </Button>

            <!--提示区-->
                <Grid Grid.Column="1" Margin="2,0,2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <ui:ProgressRing x:Name="LoadingIcon" IsActive="False" Grid.Row="0" Width="24" Height="24" HorizontalAlignment="Center"/>
                <Button x:Name="btnRefresh" Grid.Row="0" HorizontalAlignment="Center" Click="RefreshDeviceStatus_Click">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.LightningBolt}" Margin="0,0,0,0"  />
                </Button>

                <TextBlock x:Name="LoadingText" Text="" Grid.Row="1" 
                  FontSize="14"                      
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"/>
                <TextBlock x:Name="DevicesName" Text="" Grid.Row="0" Margin="12,2,0,0"
                  FontSize="12"                      
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"/>
            </Grid>

            <Button Grid.Column="2" x:Name="btnForgetPassword" HorizontalAlignment="Right" Click="ForgetPassword_Click" >
                <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.StatusCircleQuestionMark}" Content="忘记密码"  IconSize="25" Foreground="Cyan" HorizontalContentAlignment="Center" FontWeight="Bold"
                    FontSize="16"
                    Width="128" 
                    Height="28"/>
            </Button>
        </Grid>
    </Grid>
</Window>
