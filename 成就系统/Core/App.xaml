<Application x:Class="成就系统.Core.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:成就系统.Core"
             xmlns:converters="clr-namespace:成就系统.Utilities"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             StartupUri="\UI\Login\LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources/>
                <ui:XamlControlsResources/>
            </ResourceDictionary.MergedDictionaries>

            <!--Your other resources here (if exists)-->


            <!-- 评分等级转换器 -->
            <converters:ScoreToGradeConverter x:Key="ScoreToGradeConverter"/>
            <converters:ScoreToGradeColorConverter x:Key="ScoreToGradeColorConverter"/>
            <!-- 完成度转换器 -->
            <converters:CompletionDegreeToStyleConverter x:Key="DegreeConverterStyle"/>
            <converters:CompletionDegreeToColorConverter x:Key="DegreeConverterColor"/>

            <!-- 排序按钮样式 -->
            <Style x:Key="SortButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- 视觉状态管理器 -->
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBackground" 
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PressedBackground" 
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="ContentStack" 
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.8" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ContentStack" 
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.3" Duration="0"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="SortStates">
                                        <VisualState x:Name="Unsorted">
                                            <Storyboard>
                                                <!-- 未排序状态完全隐藏图标 -->
                                                <DoubleAnimation Storyboard.TargetName="IconContainer" 
                                                         Storyboard.TargetProperty="Width"
                                                         To="0" Duration="0:0:0.2"/>
                                                <!-- 修复：使用Thickness动画替代Margin.Left -->
                                                <ThicknessAnimation Storyboard.TargetName="IconContainer"
                                                             Storyboard.TargetProperty="Margin"
                                                             To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Ascending">
                                            <Storyboard>
                                                <!-- 显示升序图标 -->
                                                <DoubleAnimation Storyboard.TargetName="AscIcon" 
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="IconContainer" 
                                                         Storyboard.TargetProperty="Width"
                                                         To="16" Duration="0:0:0.2"/>
                                                <!-- 修复：使用Thickness动画替代Margin.Left -->
                                                <ThicknessAnimation Storyboard.TargetName="IconContainer"
                                                             Storyboard.TargetProperty="Margin"
                                                             To="5,0,0,0" Duration="0:0:0.2"/>
                                                <ColorAnimation Storyboard.TargetName="ActiveBorder" 
                                                         Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                         To="#FF0078D7" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Descending">
                                            <Storyboard>
                                                <!-- 显示降序图标 -->
                                                <DoubleAnimation Storyboard.TargetName="DescIcon" 
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="IconContainer" 
                                                         Storyboard.TargetProperty="Width"
                                                         To="16" Duration="0:0:0.2"/>
                                                <!-- 修复：使用Thickness动画替代Margin.Left -->
                                                <ThicknessAnimation Storyboard.TargetName="IconContainer"
                                                             Storyboard.TargetProperty="Margin"
                                                             To="5,0,0,0" Duration="0:0:0.2"/>
                                                <ColorAnimation Storyboard.TargetName="ActiveBorder" 
                                                         Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                         To="#FF0078D7" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <!-- 背景层 -->
                                <Border x:Name="NormalBackground" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4"/>

                                <Border x:Name="HoverBackground" 
                                Background="#11000000" 
                                BorderBrush="#11000000" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Opacity="0"/>

                                <Border x:Name="PressedBackground" 
                                Background="#22000000" 
                                BorderBrush="#22000000" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Opacity="0"/>

                                <Border x:Name="ActiveBorder" 
                                BorderBrush="Transparent" 
                                BorderThickness="2" 
                                CornerRadius="4"/>

                                <!-- 内容区域 - 文本在前，图标在后 -->
                                <StackPanel x:Name="ContentStack"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0">

                                    <!-- 文本内容 -->
                                    <TextBlock x:Name="ButtonText" 
                                       Text="{TemplateBinding Content}" 
                                       VerticalAlignment="Center"/>

                                    <!-- 图标容器 - 初始宽度为0 -->
                                    <Grid x:Name="IconContainer"
                                  Width="0" Height="16" 
                                  VerticalAlignment="Center"
                                  Margin="0">
                                        <!-- 升序图标 -->
                                        <ui:FontIcon x:Name="AscIcon"
                                    Icon="{x:Static ui:SegoeFluentIcons.Up}"
                                    Opacity="0"
                                    FontSize="14"/>

                                        <!-- 降序图标 -->
                                        <ui:FontIcon x:Name="DescIcon"
                                    Icon="{x:Static ui:SegoeFluentIcons.Down}"
                                    Opacity="0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- B类按钮样式 -->
            <Style x:Key="SmallCategoryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- 视觉状态管理器 -->
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBackground" 
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.4" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PressedBackground" 
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.6" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>

                                    <!-- 新增选择状态 -->
                                    <VisualStateGroup x:Name="SelectionStates">
                                        <VisualState x:Name="Unselected"/>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <!-- 边框颜色变化 -->
                                                <ColorAnimation Storyboard.TargetName="ActiveBorder" 
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    To="#FF0078D7" Duration="0:0:0.2"/>
                                                <!-- 文字颜色变化 -->
                                                <ColorAnimation Storyboard.TargetName="ContentText" 
                                                    Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                    To="Black" Duration="0:0:0.2"/>
                                                <!-- 背景变化 -->
                                                <ColorAnimation Storyboard.TargetName="SelectedBackground" 
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#110078D7" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <!-- 背景层 -->
                                <Border x:Name="NormalBackground" 
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4"/>

                                <Border x:Name="HoverBackground" 
                            Background="#11000000" 
                            BorderBrush="Transparent"
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4" 
                            Opacity="0"/>

                                <Border x:Name="PressedBackground" 
                            Background="#22000000" 
                            BorderBrush="Transparent"
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4" 
                            Opacity="0"/>

                                <!-- 选中状态背景 -->
                                <Border x:Name="SelectedBackground" 
                            Background="Transparent" 
                            BorderBrush="Transparent"
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4"/>

                                <!-- 活动边框 -->
                                <Border x:Name="ActiveBorder" 
                            BorderBrush="Transparent" 
                            BorderThickness="0 0 0 2"
                            CornerRadius="4"
                            VerticalAlignment="Bottom"/>

                                <!-- 内容区域 -->
                                <TextBlock x:Name="ContentText"
                               Text="{TemplateBinding Content}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="{TemplateBinding Padding}"
                               Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 成就卡片阴影效果 -->
                <DropShadowEffect x:Key="CardShadowEffect" 
                      BlurRadius="12" 
                      ShadowDepth="4" 
                      Opacity="0.15" 
                      Color="Black"/>

            <!-- 成就卡片悬浮ToolTip样式 -->
            <Style x:Key="CustomToolTipStyle" TargetType="ToolTip">
                <Setter Property="Background" Value="#FF333333"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#FF555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Opacity" Value="0.95"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="5">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--成就名称按钮样式-->
            <Style x:Key="AchievementNameButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="#333"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}"
                           TextDecorations="Underline"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="200"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#0066CC"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--成就评价描边效果样式-->
            <Style x:Key="StrokedTextStyle" TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding}"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect 
                            ShadowDepth="0" 
                            Color="Black" 
                            BlurRadius="2"
                            Opacity="1"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 添加成就悬浮按钮样式 -->
            <Style x:Key="FloatingActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="DodgerBlue"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- 阴影效果 -->
                                <Border x:Name="shadow" 
                                CornerRadius="28"
                                Background="#40000000"
                                Width="56" Height="56"
                                Margin="0,0,0,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="Black" Opacity="0.3"/>
                                    </Border.Effect>
                                </Border>

                                <!-- 圆形背景 -->
                                <Ellipse x:Name="circle" 
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="{TemplateBinding BorderThickness}"/>

                                <!-- 内容展示 -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- 鼠标悬停效果 -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="circle" Property="Fill" Value="#FF1A5CC9"/>
                                    <Setter TargetName="circle" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>

                                <!-- 按下效果 -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="circle" Property="Fill" Value="#FF0D3D99"/>
                                    <Setter TargetName="circle" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="shadow" Property="Margin" Value="0,0,0,1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--添加成就页面布局背景样式-->
            <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FAFAFA" Offset="0"/>
                <GradientStop Color="#F0F0F0" Offset="1"/>
            </LinearGradientBrush>

            <!--文本框样式-->
            <Style TargetType="TextBox" x:Key="FormTextBox">
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                    </Trigger>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#2196F3"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <!--评分按钮样式-->
            <Style TargetType="Button" x:Key="ScoreButtonStyle">
                <Setter Property="Width" Value="35"/>
                <Setter Property="Height" Value="35"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Background" Value="#F5F5F5"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E0E0E0"/>
                        <Setter Property="BorderBrush" Value="#999999"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 日期选择器整体样式 -->
            <Style TargetType="DatePicker" x:Key="ModernDatePickerStyle">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Grid>
                                <!-- 选择框部分 -->
                                <Border x:Name="OuterBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4"
                                        Padding="0">
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 修复：恢复日期显示绑定 -->
                                        <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Margin="8,0"
                                                   Padding="0"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   VerticalContentAlignment="Center"
                                                   HorizontalContentAlignment="Left"
                                                   Style="{DynamicResource DatePickerTextBoxStyle}"
                                                   IsReadOnly="True" 
                                                   Focusable="False"/>

                                        <!-- 日期选择按钮 -->
                                        <Button x:Name="PART_Button"
                                                Grid.Column="1"
                                                Width="36"
                                                Height="36"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Foreground="{TemplateBinding Foreground}">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.DateTime}"/>

                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 下拉内容 -->
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=OuterBorder}"
                                       StaysOpen="False">
                                    <Calendar x:Name="PART_Calendar"
                                              BorderBrush="#DDDDDD"
                                              BorderThickness="1"
                                              Background="White"/>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- 悬停效果 -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#4CAF50"/>
                                    <Setter TargetName="OuterBorder" Property="Background" Value="White"/>
                                </Trigger>

                                <!-- 焦点效果 -->
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#2196F3"/>
                                    <Setter TargetName="OuterBorder" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="OuterBorder" Property="Background" Value="White"/>
                                </Trigger>

                                <!-- 禁用状态 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="OuterBorder" Property="Background" Value="#F5F5F5"/>
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#EEEEEE"/>
                                    <Setter Property="Foreground" Value="#999999"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 日期选择器文本框样式 -->
            <Style TargetType="DatePickerTextBox" x:Key="DatePickerTextBoxStyle">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePickerTextBox">
                            <Grid Background="Transparent">
                                <!--修复：恢复日期绑定-->
                                <TextBox x:Name="PART_TextBox"
                                 Text="{Binding SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat='yyyy/MM/dd'}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontSize="15"
                                 Foreground="{TemplateBinding Foreground}"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 IsReadOnly="True"
                                 Focusable="False"/>

                                <!--水印文本-->
                                <TextBlock x:Name="WatermarkText"
                                   Text="选择日期"
                                   IsHitTestVisible="False"
                                   Foreground="#888888"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--完成度样式-->
            <Style TargetType="Border" x:Key="ProgressBlockStyle">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--下拉框样式-->
            <Style TargetType="ComboBox" x:Key="CategoryComboBoxStyle">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>

                                <!-- 背景和边框 -->
                                <Border x:Name="border" 
                            Grid.ColumnSpan="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"/>

                                <!-- 内容显示 -->
                                <ContentPresenter Grid.Column="0"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                                <!-- 下拉箭头 -->
                                <Path x:Name="arrow" 
                                      Grid.Column="1"
                                      Width="12" 
                                      Height="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L6,6 L12,0 Z"
                                      Fill="#888888"
                                      Stretch="Uniform"/>


                                <!-- 关键修复1：添加下拉触发按钮 -->
                                <ToggleButton Grid.Column="1"
                                              Width="40"
                                              Height="36"
                                              Background="Transparent"
                                              BorderBrush="Transparent"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>

                                <!-- 关键修复2：添加下拉列表容器 -->
                                <Popup x:Name="popup"
                                       Grid.ColumnSpan="2"
                                       Placement="Bottom"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Focusable="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                                <Border BorderThickness="1"
                                            BorderBrush="#E0E0E0"
                                            Background="White"
                                            CornerRadius="4"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <ScrollViewer>
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>


                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- 悬停效果 -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                </Trigger>

                                <!-- 焦点效果 -->
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2196F3"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>

                                <!-- 禁用状态 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#EEEEEE"/>
                                    <Setter TargetName="arrow" Property="Stroke" Value="#999999"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBox 下拉列表样式 -->
            <Style TargetType="ComboBoxItem" x:Key="CategoryComboBoxItemStyle">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border Background="{TemplateBinding Background}"
                        BorderThickness="0"
                        Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- 悬停效果 -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                </Trigger>

                                <!-- 选中效果 -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#BBDEFB"/>
                                    <Setter Property="Foreground" Value="#0D47A1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--帮助中心布局样式-->
            <!-- 标题样式 -->
            <Style TargetType="TextBlock" x:Key="SectionTitleStyle">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#4361ee"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
            </Style>
            <!-- 问题容器样式 -->
            <Style TargetType="Border" x:Key="QuestionContainerStyle">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Padding" Value="15"/>
            </Style>
            <!-- 问题标题样式 -->
            <Style TargetType="TextBlock" x:Key="QuestionStyle">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#2B2D42"/>
            </Style>
            <!-- 回答内容样式 -->
            <Style TargetType="TextBlock" x:Key="AnswerStyle">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="#64748b"/>
                <Setter Property="Margin" Value="0,10,0,0"/>
                <Setter Property="LineHeight" Value="22"/>
            </Style>



        </ResourceDictionary>
    </Application.Resources>
</Application>
